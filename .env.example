# 補佐やねん (MoodFlow) 環境変数設定例
# このファイルを .env にコピーして使用してください（cp .env.example .env）

# ==========================================
# 1. データベース & 認証 (Supabase / Prisma)
# ==========================================
# PostgreSQL 接続文字列 (必須)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Supabase Auth 設定 (管理画面ログイン用・任意)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGci..."

# 管理者パスワード (簡易ログイン用・任意)
ADMIN_PASSWORD="your-secure-password"

# ==========================================
# 2. Google Gemini API (AI分析・要約・A2A介入)
# ==========================================
# Google AI Studio (https://aistudio.google.com/) で取得 (必須)
GEMINI_API_KEY="AIzaSy..."

# 使用する Gemini モデル名 (任意・デフォルト: gemini-2.5-pro / A2Aは gemini-2.0-flash)
GEMINI_MODEL="gemini-2.5-pro"

# ==========================================
# 3. Google Cloud Speech-to-Text (音声認識)
# ==========================================
# プレゼンター画面でのリアルタイム文字起こしに使用
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ==========================================
# 4. Google Custom Search API (A2A話術検索)
# ==========================================
# ユーモア介入時にお笑い芸人・ファシリテーターのテクニックを検索 (任意)
GOOGLE_SEARCH_ENGINE_ID=""
# 未指定時は GEMINI_API_KEY がフォールバックとして使用されます
GOOGLE_SEARCH_API_KEY=""

# ==========================================
# 5. Google Sheets / Slides 連携 (任意)
# ==========================================
SPREADSHEET_ID=""
GOOGLE_SLIDES_FOLDER_ID=""
# サービスアカウントJSON全体、または EMAIL / PRIVATE_KEY を使用
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# ==========================================
# 6. アラート通知 / 翻訳 / バッチ設定 (任意)
# ==========================================
# ネガティブ急増時の Webhook 通知先
SLACK_WEBHOOK_URL=""
TEAMS_WEBHOOK_URL=""
ALERT_WEBHOOK_URL=""

# アラート判定パラメータ
ALERT_WINDOW_MINUTES=10
ALERT_MIN_RECENT=5
ALERT_NEG_AVG=-1.5
ALERT_COOLDOWN_SECONDS=300

# コメント自動翻訳のデフォルト言語
DEFAULT_TRANSLATION_LANG=en

# SSE ポーリング間隔 (ミリ秒)
SSE_POLL_INTERVAL_MS=1000

# 定期レポート生成バッチ用 (/api/cron-generate-reports)
CRON_SECRET=""
REPORT_LANG=ja
ENABLE_SLIDE_AUTOMATION=false
PORT=3000
