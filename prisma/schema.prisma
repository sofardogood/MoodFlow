generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id @default(uuid())
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  moods     Mood[]
  transcripts Transcript[]
  summaries Summary[]
  ownerId   Int?
  owner     User?    @relation(fields: [ownerId], references: [id])
  surveyResponses SurveyResponse[]
  questions  Question[]
  highlights Highlight[]
}

// ... existing Mood and Transcript models ...

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  sessions  Session[]
}

model Mood {
  id        Int      @id @default(autoincrement())
  sessionId String
  nickname  String
  hashedNickname String?
  score     Int
  comment   String?
  translatedComment String?
  language  String?  @default("ja")
  tag       String?
  role      String?
  department String?
  theme     String?
  emoticon  String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
}

model Transcript {
  id        Int      @id @default(autoincrement())
  sessionId String
  text      String
  speaker   String?  @default("Presenter")
  tag       String?
  language  String?  @default("ja")
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
}

model Summary {
  id        Int      @id @default(autoincrement())
  sessionId String
  content   String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
}

model SurveyResponse {
  id             Int      @id @default(autoincrement())
  sessionId      String
  nickname       String?
  hashedNickname String?
  role           String?
  department     String?
  satisfaction   Int?
  positive       String?
  improvement    String?
  createdAt      DateTime @default(now())
  session        Session  @relation(fields: [sessionId], references: [id])
}

model Question {
  id             Int      @id @default(autoincrement())
  sessionId      String
  nickname       String?
  hashedNickname String?
  text           String
  status         String   @default("open") // open, answered, archived
  createdAt      DateTime @default(now())
  session        Session  @relation(fields: [sessionId], references: [id])
  votes          QuestionVote[]
}

model QuestionVote {
  id         Int      @id @default(autoincrement())
  questionId Int
  hashedNickname String?
  createdAt  DateTime @default(now())
  question   Question @relation(fields: [questionId], references: [id])
}

model TagOverride {
  id         Int      @id @default(autoincrement())
  sessionId  String
  sourceType String   // mood | transcript
  sourceId   Int
  tag        String
  createdAt  DateTime @default(now())
}

model Highlight {
  id         Int      @id @default(autoincrement())
  sessionId  String
  text       String
  tag        String?
  sourceType String?  // transcript | mood | manual
  sourceId   Int?
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id])
}

model InterventionLog {
  id          Int      @id @default(autoincrement())
  sessionId   String?
  context     String   // 介入時の状況説明
  dialogue    String   // エージェント間の対話ログ (JSON string)
  suggestion  String   // 最終的な提案内容
  successRating Int?   // 1-5: 効果があったかどうか（後で評価）
  createdAt   DateTime @default(now())
}