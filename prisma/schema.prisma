generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id        String   @id @default(uuid())
  name      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  moods     Mood[]
  transcripts Transcript[]
  summaries Summary[]
  ownerId   Int?
  owner     User?    @relation(fields: [ownerId], references: [id])
}

// ... existing Mood and Transcript models ...

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  sessions  Session[]
}

model Mood {
  id        Int      @id @default(autoincrement())
  sessionId String
  nickname  String
  score     Int
  comment   String?
  emoticon  String?
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
}

model Transcript {
  id        Int      @id @default(autoincrement())
  sessionId String
  text      String
  speaker   String?  @default("Presenter")
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
}

model Summary {
  id        Int      @id @default(autoincrement())
  sessionId String
  content   String
  startTime DateTime
  endTime   DateTime
  createdAt DateTime @default(now())
  session   Session  @relation(fields: [sessionId], references: [id])
}

